{
  "name": "express-ts-starter-template",
  "version": "1.0.0",
  "description": "Express TypeScript Starter Template with Sequelize ORM. The application is structured in a modular way, with each module having its own routes, controllers, services, and models. This structure promotes separation of concerns and makes it easier to maintain and scale the application.",
  "main": "src/index.js",
  "module": "commonjs",
  "moduleResolution": "node",
  "scripts": {
    "start_app": "tsc && node dist/index.js",
    "start": "nodemon --exec npm run start_app",
    "build": "tsc",
    "test": "node --test --import ts-node/register tests/**/*.test.js",
    "migration:make": "npx sequelize-cli migration:generate --name",
    "seed:make": "npx sequelize-cli seed:generate --name",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:migrate:undo": "npx sequelize-cli db:migrate:undo",
    "db:seed": "npx sequelize-cli db:seed:all",
    "db:seed:undo": "npx sequelize-cli db:seed:undo:all"
  },
  "keywords": [
    "testing"
  ],
  "author": "Mohit Raj Panday",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.1",
    "mysql2": "^3.22.5",
    "nodemon": "^3.1.7",
    "path": "^0.12.7",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "url": "^0.11.4",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.1",
    "@types/node": "^26.0.1",
    "@types/reflect-metadata": "^0.1.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
